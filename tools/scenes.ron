// The downloaded scenes gfx_viewer lists. The testbed's own scenes are built in code and are not listed here.
//
// Every entry is one scene of the viewer's list. The viewer shows each entry; one whose file is missing is greyed
// out with "run tools/fetch-scenes.sh". Nothing a path points to is in this repository: the files live in
// ~/.local/share/bevy-graficos/scenes/ ($BEVY_GFX_SDK_DIR/scenes), written by tools/fetch-scenes.sh or by the
// download/convert scripts named in `fetch`, and they keep their own licences.
//
// To add a scene, append an entry. Required fields: id, name, path, licence, non_commercial. Every other field is
// optional and may be left out. Fields:
//
//   id:             "bistro-exterior"   unique, lower-case, [a-z0-9-]; used by --scene, --self-test-scenes and as
//                                       the name of the scene's bake folder.
//   name:           "Bistro (exterior)" what the list shows.
//   path:           "bistro/BistroExterior.glb"
//                                       the .gltf or .glb to load, relative to the scenes folder (`base: Scenes`,
//                                       the default) or to this repository's assets/ folder (`base: RepoAssets`).
//   base:           Scenes | RepoAssets (default Scenes)
//   licence:        "CC-BY 4.0: credit …"  one line, shown next to the scene. Say who to credit.
//   non_commercial: true | false        true for anything that may not be used in a commercial product (NC
//                                       licences, the CRYENGINE agreement, "look only"): the list marks it
//                                       "no comercial".
//   fetch:          "tools/fetch-scenes.sh bistro"  the command that puts the file there (shown when missing).
//   exposure:       12.0                the camera's EV100 for this scene. Default: 12.0 when the viewer adds
//                                       its default sun and sky, else Bevy's default exposure.
//   camera:         (position: (x, y, z), look_at: (x, y, z))
//                                       where the camera starts, in metres in the scene's own frame (after
//                                       `scale`). Default: placed from the meshes' bounds.
//   sun:            Auto | Off | Sun(direction: (x, y, z), illuminance: 100000.0)
//                                       Auto (default): the viewer's default sun and sky when the file has no
//                                       light of its own. Off: never add a sun (a night scene lit by its lamps;
//                                       no sky either). Sun(...): add this sun and the sky unless the file has a
//                                       directional light; `direction` is where the light travels (pointing down),
//                                       `illuminance` in lux.
//   scale:          10.0                uniform scale of the file's root (default 1.0).
//   extra:          [(path: "…", translation: (x, y, z), rotation_y: 90.0, scale: 2.0)]
//                                       more files placed in the same scene (paths as `path`, same `base`;
//                                       rotation_y in degrees; every field but path optional). Default [].
//
// Keep it one entry per scene. The viewer refuses the whole file, naming the line, when it does not parse.
(
    scenes: [
        (
            id: "bistro-exterior",
            name: "Bistro (exterior)",
            path: "bistro/BistroExterior.glb",
            licence: "CC-BY 4.0: Amazon Lumberyard Bistro, credit Amazon Lumberyard (NVIDIA ORCA)",
            non_commercial: false,
            fetch: "tools/fetch-scenes.sh bistro",
            // The first frame of the FBX's own camera (Blender, converted to glTF axes).
            camera: (position: (24.82, 3.16, -61.65), look_at: (23.21, 2.85, -56.93)),
        ),
        (
            id: "bistro-interior",
            name: "Bistro (interior)",
            path: "bistro/BistroInterior_Wine.glb",
            licence: "CC-BY 4.0: Amazon Lumberyard Bistro, credit Amazon Lumberyard (NVIDIA ORCA)",
            non_commercial: false,
            fetch: "tools/fetch-scenes.sh bistro",
            camera: (position: (3.45, 2.26, -2.25), look_at: (8.41, 2.09, -2.81)),
        ),
        (
            id: "pica-pica",
            name: "PICA PICA (mini diorama + robot)",
            path: "pica-pica/mini_diorama_01.glb",
            licence: "CC-BY-NC 4.0: PICA PICA assets, credit SEED - Electronic Arts",
            non_commercial: true,
            fetch: "tools/fetch-scenes.sh pica-pica",
            // As Bevy's solari example places them.
            scale: 10.0,
            extra: [(path: "pica-pica/robot_01.glb", translation: (-2.0, 0.05, -2.1), rotation_y: 90.0, scale: 2.0)],
            // Bevy's solari example's sun (FULL_DAYLIGHT) and its default exposure. to tune.
            sun: Sun(direction: (0.462, -0.707, 0.535), illuminance: 20000.0),
            exposure: 9.7,
        ),
        (
            id: "zero-day",
            name: "Zero Day",
            path: "zero-day/ZeroDay.glb",
            licence: "CC-BY 4.0: Zero Day, credit Beeple (NVIDIA ORCA)",
            non_commercial: false,
            fetch: "tools/fetch-scenes.sh zero-day",
            camera: (position: (13.35, -0.36, -0.01), look_at: (8.35, -0.26, -0.11)),
            sun: Off,
            // Lit by its emissive surfaces alone (strength 100, see tools/fetch-scenes.sh). to tune.
            exposure: 2.0,
        ),
        (
            id: "sponza",
            name: "Sponza (Crytek)",
            path: "glTF-Sample-Assets/Models/Sponza/glTF/Sponza.gltf",
            licence: "CRYENGINE Limited License Agreement: look only, never ship or publish",
            non_commercial: true,
            fetch: "tools/fetch-scenes.sh sponza",
        ),
        (
            id: "abeautifulgame",
            name: "A Beautiful Game",
            path: "glTF-Sample-Assets/Models/ABeautifulGame/glTF/ABeautifulGame.gltf",
            licence: "CC-BY 4.0: credit ASWF (2020) and Ed Mackey (2022)",
            non_commercial: false,
            fetch: "tools/fetch-scenes.sh abeautifulgame",
        ),
        (
            id: "flighthelmet",
            name: "Flight Helmet",
            path: "models/FlightHelmet/FlightHelmet.gltf",
            base: RepoAssets,
            licence: "CC0: Bevy's assets/ (Khronos sample model)",
            non_commercial: false,
        ),
        // From tools/fetch-scenes-extra.sh (V3).

        (
            id: "classroom",
            name: "Classroom (Blender demo)",
            path: "classroom/Classroom.glb",
            licence: "CC0: Classroom by Christophe Seux (Blender demo files)",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh classroom",
            camera: (position: (2.576, 1.094, 4.466), look_at: (1.820, 1.128, 1.563)),
            // The file's sun (its convert.log SUN line: 16.6 W/m2 at 683 lm/W), given here so that it casts shadow
            // maps on Raster; it also lights the sky seen through the windows, which stands for the source's
            // daylight portals. Exposure to tune: traced rungs nearest Cycles' frame (mean luma 106) while
            // Raster, whose sky light is not occluded, stays below white.
            exposure: 9.5,
            sun: Sun(direction: (-0.874, -0.479, -0.082), illuminance: 11344.0),
        ),
        (
            id: "barbershop",
            name: "Barbershop (Blender demo)",
            path: "barbershop/Barbershop.glb",
            licence: "CC-BY 4.0: Barbershop Interior, credit Blender Animation Studio (Agent 327)",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh barbershop",
            camera: (position: (2.656, 1.489, -8.902), look_at: (1.807, 1.334, -6.029)),
            // Lit by its own lamps only: its white world adds nothing in Cycles (mean luma 67.8 with or without
            // it), so no viewer sky or sun. Exposure to tune: 7.5 matches Cycles' units (683/pi nits shown as 1.0),
            // but Bevy cannot apply the lamps' "Smooth" falloff and the converter loses dark materials, so 9.0 brings
            // the traced rungs to Cycles' mean luma (71 against 68).
            exposure: 9.0,
            sun: Off,
        ),
        (
            id: "bathroom",
            name: "Salle de bain (Bitterli)",
            path: "bathroom/Bathroom.glb",
            licence: "CC-BY 3.0: 'Salle de bain' by nacimus, Mitsuba version by Benedikt Bitterli",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh bathroom",
            camera: (position: (0.444, 1.693, 4.991), look_at: (0.101, 1.354, 2.030)),
            sun: Off,
        ),
        (
            id: "living-room",
            name: "Modern Living Room (Bitterli)",
            path: "living-room/LivingRoom.glb",
            licence: "CC-BY 3.0: 'The Modern Living Room' by Wig42, Mitsuba version by Benedikt Bitterli",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh living-room",
            camera: (position: (0.277, 1.018, -5.193), look_at: (-1.036, 0.932, -2.497)),
            sun: Off,
        ),
        (
            id: "intel-sponza",
            name: "Intel Sponza (day, curtains, ivy, trees)",
            path: "intel-sponza/source/main_sponza/NewSponza_Main_day.gltf",
            licence: "Intel Sample Library, personal and educational use: credit Frank Meinl, Anton Kaplanyan and the Sponza add-on crew",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh intel-sponza",
            // Intel's packages share the base scene's frame: the add-ons go in at the origin.
            extra: [
                (path: "intel-sponza/source/pkg_a_curtains/NewSponza_Curtains_glTF.gltf"),
                (path: "intel-sponza/source/pkg_b_ivy/NewSponza_IvyGrowth_glTF.gltf"),
                (path: "intel-sponza/source/pkg_c_trees/NewSponza_CypressTree_glTF.gltf"),
            ],
        ),
        // Intel's 10 000-candle package (pkg_d) is downloaded but not listed: its flames are one emissive mesh of
        // 2 720 000 triangles and Solari panics above 65 535 per emissive mesh (bevy_solari scene/binder/lights.rs).
        (
            id: "sun-temple",
            name: "Sun Temple (Epic, NVIDIA ORCA)",
            path: "sun-temple/SunTemple.glb",
            licence: "CC-BY-NC-SA 4.0: Sun Temple, credit Epic Games (NVIDIA ORCA)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh sun-temple",
            camera: (position: (0.128, 3.170, 70.874), look_at: (-0.070, 3.000, 67.885)),
        ),
        (
            id: "emerald-square-day",
            name: "Emerald Square, day (NVIDIA ORCA)",
            path: "emerald-square/EmeraldSquareDay.gltf",
            licence: "CC-BY-NC-SA 3.0: Emerald Square, credit NVIDIA (ORCA)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh emerald-square",
            camera: (position: (-38.370, 1.460, 75.722), look_at: (-38.005, 1.474, 72.744)),
        ),
        (
            id: "emerald-square-dusk",
            name: "Emerald Square, dusk (NVIDIA ORCA)",
            path: "emerald-square/EmeraldSquareDusk.gltf",
            licence: "CC-BY-NC-SA 3.0: Emerald Square, credit NVIDIA (ORCA)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh emerald-square",
            camera: (position: (-38.370, 1.460, 75.722), look_at: (-38.005, 1.474, 72.744)),
            // Dusk has no lights of its own: lit by its emissive surfaces (x100, as Zero Day), so no
            // viewer sun and no sky. to tune: emissive scale and exposure were picked from one self-test.
            sun: Off,
            exposure: 0.0,
        ),
        (
            id: "san-miguel",
            name: "San Miguel (McGuire Archive)",
            path: "san-miguel/SanMiguel.glb",
            licence: "Free for research and educational use with credit: Guillermo M. Leal Llaguno (McGuire Computer Graphics Archive)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh san-miguel",
        ),
        (
            id: "stained-glass-lamp",
            name: "Stained Glass Lamp (Khronos)",
            path: "khronos-extra/glTF-Sample-Assets/Models/StainedGlassLamp/glTF/StainedGlassLamp.gltf",
            licence: "CC-BY 4.0: credit Wayfair (Khronos glTF-Sample-Assets)",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh khronos-extra",
        ),
        (
            id: "dragon-attenuation",
            name: "Dragon Attenuation (Khronos)",
            path: "khronos-extra/glTF-Sample-Assets/Models/DragonAttenuation/glTF/DragonAttenuation.gltf",
            licence: "Stanford Graphics Library terms (research use; dragon by Stanford, glTF by Morgan McGuire); cloth CC0 (Adobe)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh khronos-extra",
        ),
    ],
)
