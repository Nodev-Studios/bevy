// More downloaded scenes for gfx_viewer, in the format of tools/scenes.ron (its header lists every field). The lead
// merges these entries into tools/scenes.ron. Files come from tools/fetch-scenes-extra.sh <id> (downloads, prints
// the licence, converts to .glb with Blender headless); nothing here is in this repository.
//
// camera: the source file's own camera (Blender / Mitsuba), in the glTF's frame; for the ORCA scenes one of their
// cameras. exposure: EV100, set where the default was clearly wrong on the NVIDIA self-test sheets ("to tune": the
// owner's eye decides). non_commercial: true for NC licences and "personal / educational / research use" terms.
(
    scenes: [
        (
            id: "classroom",
            name: "Classroom (Blender demo)",
            path: "classroom/Classroom.glb",
            licence: "CC0: Classroom by Christophe Seux (Blender demo files)",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh classroom",
            camera: (position: (2.576, 1.094, 4.466), look_at: (1.820, 1.128, 1.563)),
        ),
        (
            id: "barbershop",
            name: "Barbershop (Blender demo)",
            path: "barbershop/Barbershop.glb",
            licence: "CC-BY 4.0: Barbershop Interior, credit Blender Animation Studio (Agent 327)",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh barbershop",
            camera: (position: (2.656, 1.489, -8.902), look_at: (1.807, 1.334, -6.029)),
        ),
        (
            id: "bathroom",
            name: "Salle de bain (Bitterli)",
            path: "bathroom/Bathroom.glb",
            licence: "CC-BY 3.0: 'Salle de bain' by nacimus, Mitsuba version by Benedikt Bitterli",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh bathroom",
            camera: (position: (0.444, 1.693, 4.991), look_at: (0.101, 1.354, 2.030)),
            sun: Off,
        ),
        (
            id: "living-room",
            name: "Modern Living Room (Bitterli)",
            path: "living-room/LivingRoom.glb",
            licence: "CC-BY 3.0: 'The Modern Living Room' by Wig42, Mitsuba version by Benedikt Bitterli",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh living-room",
            camera: (position: (0.277, 1.018, -5.193), look_at: (-1.036, 0.932, -2.497)),
            sun: Off,
        ),
        (
            id: "intel-sponza",
            name: "Intel Sponza (day, curtains, ivy, trees)",
            path: "intel-sponza/source/main_sponza/NewSponza_Main_day.gltf",
            licence: "Intel Sample Library, personal and educational use: credit Frank Meinl, Anton Kaplanyan and the Sponza add-on crew",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh intel-sponza",
            // Intel's packages share the base scene's frame: the add-ons go in at the origin.
            extra: [
                (path: "intel-sponza/source/pkg_a_curtains/NewSponza_Curtains_glTF.gltf"),
                (path: "intel-sponza/source/pkg_b_ivy/NewSponza_IvyGrowth_glTF.gltf"),
                (path: "intel-sponza/source/pkg_c_trees/NewSponza_CypressTree_glTF.gltf"),
            ],
        ),
        // Intel's 10 000-candle package (pkg_d) is downloaded but not listed: its flames are one emissive mesh of
        // 2 720 000 triangles and Solari panics above 65 535 per emissive mesh (bevy_solari scene/binder/lights.rs).
        (
            id: "sun-temple",
            name: "Sun Temple (Epic, NVIDIA ORCA)",
            path: "sun-temple/SunTemple.glb",
            licence: "CC-BY-NC-SA 4.0: Sun Temple, credit Epic Games (NVIDIA ORCA)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh sun-temple",
            camera: (position: (0.128, 3.170, 70.874), look_at: (-0.070, 3.000, 67.885)),
        ),
        (
            id: "emerald-square-day",
            name: "Emerald Square, day (NVIDIA ORCA)",
            path: "emerald-square/EmeraldSquareDay.glb",
            licence: "CC-BY-NC-SA 3.0: Emerald Square, credit NVIDIA (ORCA)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh emerald-square",
            camera: (position: (-38.370, 1.460, 75.722), look_at: (-38.005, 1.474, 72.744)),
        ),
        (
            id: "emerald-square-dusk",
            name: "Emerald Square, dusk (NVIDIA ORCA)",
            path: "emerald-square/EmeraldSquareDusk.glb",
            licence: "CC-BY-NC-SA 3.0: Emerald Square, credit NVIDIA (ORCA)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh emerald-square",
            camera: (position: (-38.370, 1.460, 75.722), look_at: (-38.005, 1.474, 72.744)),
        ),
        (
            id: "san-miguel",
            name: "San Miguel (McGuire Archive)",
            path: "san-miguel/SanMiguel.glb",
            licence: "Free for research and educational use with credit: Guillermo M. Leal Llaguno (McGuire Computer Graphics Archive)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh san-miguel",
        ),
        (
            id: "stained-glass-lamp",
            name: "Stained Glass Lamp (Khronos)",
            path: "khronos-extra/glTF-Sample-Assets/Models/StainedGlassLamp/glTF/StainedGlassLamp.gltf",
            licence: "CC-BY 4.0: credit Wayfair (Khronos glTF-Sample-Assets)",
            non_commercial: false,
            fetch: "tools/fetch-scenes-extra.sh khronos-extra",
        ),
        (
            id: "dragon-attenuation",
            name: "Dragon Attenuation (Khronos)",
            path: "khronos-extra/glTF-Sample-Assets/Models/DragonAttenuation/glTF/DragonAttenuation.gltf",
            licence: "Stanford Graphics Library terms (research use; dragon by Stanford, glTF by Morgan McGuire); cloth CC0 (Adobe)",
            non_commercial: true,
            fetch: "tools/fetch-scenes-extra.sh khronos-extra",
        ),
    ],
)
